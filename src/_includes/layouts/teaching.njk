{% extends "layouts/base.njk" -%}

{%- block content -%}

{{ content | safe }}

<article>
<h2>Tutoring</h2>
<p>I have tutored the following courses at the <strong>University of Edinburgh</strong>.</p>

<table class="tutoring-table">
<thead>
	<tr>
		<th>Course name</th>
		<th>Dates taught</th>
	</tr>
</thead>
<tbody>
	{%- for course in tutoredCourses -%}
	<tr>
		<td>{{ course.name }}</td>
		<td>
			{%- for year in course.years -%}
			<p>{{ year }}</p>
			{%- endfor -%}
		</td>
	<tr>
	{%- endfor -%}
</tbody>
</table>
</article>

{%- endblock -%}

