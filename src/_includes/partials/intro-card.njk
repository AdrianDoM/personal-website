<div class="about-card">
    <img 
        src="{{ introData.image }}"
        alt="{{ introData.imageAlt }}"
    >
    <div class="grid-bullet-list">
        <span class="emoji bullet">✉</span>
        <a href="mailto:{{ introData.email }}">{{ introData.email }}</a>

        <i class="fa-brands fa-github bullet" aria-hidden="true"></i>
        <a href="https://github.com/{{ introData.github }}">{{ introData.github }}</a>
    </div>
</div>